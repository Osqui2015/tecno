{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "type-check": "vue-tsc --noEmit",
        "watch": "vite build --watch",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:buyer": "playwright test tests/e2e/buyer-flow.spec.ts",
        "test:e2e:admin": "playwright test tests/e2e/admin-flow.spec.ts",
        "test:e2e:checkout": "playwright test tests/e2e/checkout-flow.spec.ts",
        "test:e2e:2fa": "playwright test tests/e2e/two-factor.spec.ts",
        "test:e2e:markup": "playwright test tests/e2e/admin-markup.spec.ts"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.1.2",
        "@vitejs/plugin-vue": "^6.0.8",
        "laravel-vite-plugin": "^2.0.0",
        "otplib": "^13.4.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.4.5",
        "vite": "^7.0.7",
        "vue-tsc": "^3.3.9"
    },
    "dependencies": {
        "axios": "^1.19.0",
        "pinia": "^4.0.2",
        "vue": "^3.5.41",
        "vue-router": "^5.2.0"
    }
}
